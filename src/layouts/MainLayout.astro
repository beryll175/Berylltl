---

const {
title = "Beryll TL | Chinese Novel Translations",
description = "Chinese novels translated into English."
} = Astro.props;

---
<!DOCTYPE html><html lang="en">
<head>
<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#151515" />
  <meta name="description" content={description} />
  <title>{title}</title>  <style is:global>
    :root {
      --background: #151515;
      --surface: #222222;
      --surface-light: #2b2b2b;
      --accent: #f39a35;
      --text: #eeeeee;
      --muted: #aaaaaa;
      --border: #383838;
      --max-width: 1200px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--background);
      color: var(--text);
      font-family: Arial, sans-serif;
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    .site-header {
      border-bottom: 1px solid var(--border);
      background: var(--background);
    }

    .header-inner {
      max-width: var(--max-width);
      margin: auto;
      padding: 18px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      color: var(--accent);
      font-size: 25px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 25px;
      font-size: 14px;
    }

    .site-nav a:hover {
      color: var(--accent);
    }

    .page-container {
      max-width: var(--max-width);
      margin: auto;
      padding: 35px 24px;
      min-height: 65vh;
    }

    .site-footer {
      border-top: 1px solid var(--border);
      padding: 28px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
    }

    .accent {
      color: var(--accent);
    }

    @media (max-width: 600px) {
      .header-inner {
        padding: 15px 16px;
        flex-wrap: wrap;
      }

      .logo {
        font-size: 22px;
      }

      .site-nav {
        gap: 16px;
        font-size: 13px;
      }

      .page-container {
        padding: 25px 16px;
      }
    }
  </style></head><body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">BERYLL TL</a>  <nav class="site-nav">
    <a href="/">Home</a>
    <a href="/novels/">Novels</a>
    <a href="/#patreon">Patreon</a>
  </nav>
</div>

  </header>  <main class="page-container">
    <slot />
  </main>  <footer class="site-footer">
    © {new Date().getFullYear()} Beryll TL. All rights reserved.
  </footer>
</body>
</html>