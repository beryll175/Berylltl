---

const {
chapters = [],
chaptersPerPage = 50
} = Astro.props;

const tableId = "chapter-table-${Math.random().toString(36).slice(2, 9)}";
---
<div class="chapter-section" id={tableId}>
  <div class="section-heading">
    <div>
      <h2>Chapters</h2>
      <p class="chapter-count">Showing chapters <span class="range-start">1</span>–<span class="range-end">{Math.min(chapters.length, chaptersPerPage)}</span> of {chapters.length}</p>
    </div>
  </div>{chapters.length > 0 ? (
<>
<div class="table-wrapper">
<table>
<thead>
<tr>
<th>Chapter</th>
<th>Title</th>
<th>Volume</th>
<th>Updated</th>
</tr>
</thead>

      <tbody>
        {chapters.map((chapter, index) => (
          <tr class="chapter-row" data-index={index}>
            <td class="chapter-number">{chapter.number ?? index + 1}</td>
            <td>
              <a href={chapter.href} class="chapter-link">
                {chapter.title || `Chapter ${chapter.number ?? index + 1}`}
              </a>
            </td>
            <td class="volume">{chapter.volume || "—"}</td>
            <td class="updated">{chapter.updated || "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <<div class="pagination">
  <button class="page-button previous" disabled>← Previous</button>

  <div class="page-numbers"></div>

  <button class="page-button next">Next →</button>
</div>
</>

) : (
<p class="empty-state">Chapters will be added soon.</p>
)}

</div><script>
  document.querySelectorAll(".chapter-section").forEach((section) => {
    if (section.dataset.initialized) return;
    section.dataset.initialized = "true";

    const rows = Array.from(section.querySelectorAll(".chapter-row"));
    const previous = section.querySelector(".previous");
    const next = section.querySelector(".next");
    const pageNumbers = section.querySelector(".page-numbers");
    const rangeStart = section.querySelector(".range-start");
    const rangeEnd = section.querySelector(".range-end");

    const pageSize = 50;
    const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
    let currentPage = 1;

    function renderPage() {
      const start = (currentPage - 1) * pageSize;
      const end = Math.min(start + pageSize, rows.length);

      rows.forEach((row, index) => {
        row.hidden = index < start || index >= end;
      });

      if (rangeStart) {
        rangeStart.textContent = rows.length ? String(start + 1) : "0";
      }

      if (rangeEnd) {
        rangeEnd.textContent = String(end);
      }

      previous.disabled = currentPage === 1;
      next.disabled = currentPage === totalPages;

      pageNumbers.innerHTML = "";

      for (let page = 1; page <= totalPages; page++) {
        const button = document.createElement("button");

        button.className = "page-button";
        button.textContent = page;
        button.type = "button";

        if (page === currentPage) {
          button.classList.add("active");
          button.setAttribute("aria-current", "page");
        }

        button.addEventListener("click", () => {
          currentPage = page;
          renderPage();
        });

        pageNumbers.appendChild(button);
      }
    }

    previous.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        renderPage();
      }
    });

    next.addEventListener("click", () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderPage();
      }
    });

    renderPage();
  });
</script><style>
  .chapter-section {
    margin: 35px 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .section-heading h2 {
    font-size: 23px;
  }

  .chapter-count {
    color: var(--muted);
    font-size: 13px;
    margin-top: 3px;
  }

  .table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 13px;
  }

  th {
    background: var(--surface-light);
    color: var(--accent);
    font-weight: 600;
    padding: 14px 16px;
  }

  td {
    padding: 13px 16px;
    border-top: 1px solid var(--border);
  }

  tbody tr:hover {
    background: var(--surface);
  }

  .chapter-number {
    color: var(--muted);
    white-space: nowrap;
    width: 100px;
  }

  .chapter-link:hover {
    color: var(--accent);
  }

  .volume,
  .updated {
    color: var(--muted);
    white-space: nowrap;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    margin-top: 20px;
  }

  .page-button {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 9px 15px;
    border-radius: 4px;
    font-size: 12px;
  }

  .page-button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .page-button:not(:disabled):hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .page-indicator {
    color: var(--muted);
    font-size: 12px;
  }

  .empty-state {
    padding: 30px;
    text-align: center;
    background: var(--surface);
    border-radius: 6px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    table {
      font-size: 12px;
    }

    th,
    td {
      padding: 11px 9px;
    }

    .pagination {
      gap: 10px;
    }

    .page-button {
      padding: 8px 10px;
    }
  }
           </style>