---

import { getCollection, render } from "astro:content";
import MainLayout from "../../../layouts/MainLayout.astro";
import ChapterNavigation from "../../../components/ChapterNavigation.astro";
import ReaderControls from "../../../components/ReaderControls.astro";
import { novels } from "../../../content/novels.js";

export async function getStaticPaths() {
const entries = await getCollection("chapters");

return entries.map((entry) => {
const novel = novels.find(
(item) => item.slug === entry.data.novel
);

if (!novel) return null;

const novelChapters = entries
  .filter((item) => item.data.novel === novel.slug)
  .sort((a, b) => a.data.number - b.data.number);

const index = novelChapters.findIndex(
  (item) => item.id === entry.id
);

const previous = novelChapters[index - 1];
const next = novelChapters[index + 1];

return {
  params: {
    slug: novel.slug,
    chapter: String(entry.data.number)
  },
  props: {
  novel,
  entry,
  previousHref: previous
    ? `/novels/${novel.slug}/${previous.data.number}/`
    : "",
  previousTitle: previous ? previous.data.title : "",
  nextHref: next
    ? `/novels/${novel.slug}/${next.data.number}/`
    : "",
  nextTitle: next ? next.data.title : ""
  }
};

}).filter(Boolean);
}

const {
  novel,
  entry,
  previousHref,
  previousTitle,
  nextHref,
  nextTitle
} = Astro.props;
const { Content } = await render(entry);

const chapterListHref = "/novels/${novel.slug}/#chapter-list";
---
<MainLayout
title={"${entry.data.title} | ${novel.title}"}
description={"Read ${entry.data.title} of ${novel.title}."}

«»

  <article class="reader"><div class="breadcrumb">
  <a href="/">Home</a>
  <span>›</span>
  <a href={`/novels/${novel.slug}/`}>{novel.title}</a>
  <span>›</span>
  <span>Chapter {entry.data.number}</span>
</div>

<header class="reader-heading">
  <h1>{novel.title}</h1>
  <p class="chapter-title">{entry.data.title}</p>
  <p class="chapter-info">
    Chapter {entry.data.number}
    {entry.data.updated && ` · ${entry.data.updated}`}
  </p>
</header>

<ChapterNavigation
  previousHref={previousHref}
  nextHref={nextHref}
  chapterListHref={chapterListHref}
  previousTitle={previousTitle}
nextTitle={nextTitle}
/>

<ReaderControls />

<div class="chapter-content">
  <Content />
</div>

<ChapterNavigation
  previousHref={previousHref}
  nextHref={nextHref}
  chapterListHref={chapterListHref}
  previousTitle={previousTitle}
nextTitle={nextTitle}
/>

<div class="back-to-novel">
  <a href={`/novels/${novel.slug}/`}>← Back to {novel.title}</a>
</div>

  </article>
</MainLayout><style>
  .reader {
    max-width: 850px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 25px;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .reader-heading {
    text-align: center;
    padding: 25px 10px;
    border-bottom: 1px solid var(--border);
  }

  .reader-heading h1 {
    font-size: 25px;
    line-height: 1.4;
  }

  .chapter-title {
    font-size: 19px;
    color: var(--accent);
    margin-top: 12px;
  }

  .chapter-info {
    color: var(--muted);
    font-size: 12px;
    margin-top: 10px;
  }

  .chapter-content {
    padding: 25px 10px;
    color: var(--text);
    font-size: 17px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .chapter-content[data-theme="dark"] {
    background: #151515;
    color: #eeeeee;
  }

  .chapter-content[data-theme="light"] {
    background: #ffffff;
    color: #222222;
  }

  .chapter-content[data-theme="sepia"] {
    background: #f1e5c9;
    color: #5b4632;
    padding: 25px;
    border-radius: 6px;
  }

  .back-to-novel {
    text-align: center;
    margin: 25px 0;
    font-size: 13px;
  }

  .back-to-novel a {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .reader-heading h1 {
      font-size: 21px;
    }

    .chapter-title {
      font-size: 17px;
    }

    .chapter-content {
      padding: 20px 5px;
      font-size: 16px;
      line-height: 1.85;
    }
  }
 </style>