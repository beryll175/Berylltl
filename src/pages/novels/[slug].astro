---
import MainLayout from "../../layouts/MainLayout.astro";
import ChapterTable from "../../components/ChapterTable.astro";
import { novels } from "../../content/novels.js";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("chapters");

  return novels.map((novel) => {
    const chapters = entries
      .filter((entry) => entry.data.novel === novel.slug)
      .sort((a, b) => a.data.number - b.data.number)
      .map((entry) => ({
        number: entry.data.number,
        title: entry.data.title,
        volume: entry.data.volume || "",
        updated: entry.data.updated || "",
        href: `/novels/${novel.slug}/${entry.data.number}/`
      }));

    return {
      params: { slug: novel.slug },
      props: { novel, chapters }
    };
  });
}

const { novel, chapters } = Astro.props;
const totalChapters = chapters.length;
---

<MainLayout
  title={`${novel.title} | Beryll TL`}
  description={novel.synopsis}
>

  <div class="novel-page"><a href="/" class="back-link">← Back to Home</a>

<section class="novel-header">

  <div class="cover-container">
    {novel.cover ? (
      <img src={novel.cover} alt={`${novel.title} cover`} class="cover" />
    ) : (
      <div class="cover-placeholder">
        <span>BERYLL TL</span>
        <strong>{novel.title}</strong>
      </div>
    )}
  </div>

  <div class="novel-details">

    <span class="status">{novel.status}</span>

    <h1>{novel.title}</h1>

    {novel.rawTitle && (
      <p class="raw-title">{novel.rawTitle}</p>
    )}

    <p class="author">By {novel.author}</p>

    <div class="metadata">
      <span>📖 {totalChapters} Chapters</span>
      <span>🌐 Chinese → English</span>
    </div>

    {novel.genres.length > 0 && (
      <div class="genres">
        {novel.genres.map((genre) => (
          <span class="genre">{genre}</span>
        ))}
      </div>
    )}

    <div class="action-buttons">
      {chapters.length > 0 && (
        <a href={chapters[0].href} class="read-button">
          Start Reading →
        </a>
      )}

      {novel.novelUpdates && (
        <a
          href={novel.novelUpdates}
          target="_blank"
          rel="noopener noreferrer"
          class="external-button"
        >
          Novel Updates ↗
        </a>
      )}

      {novel.patreon && (
        <a
          href={novel.patreon}
          target="_blank"
          rel="noopener noreferrer"
          class="external-button"
        >
          Support on Patreon
        </a>
      )}
    </div>

  </div>
</section>

<section class="synopsis-section">
  <h2>Synopsis</h2>
  <p>{novel.synopsis}</p>
</section>

<div id="chapter-list">
  <ChapterTable chapters={chapters} />
</div>

  </div>
</MainLayout><style>
  .novel-page {
    max-width: 1000px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: var(--muted);
    margin-bottom: 25px;
    font-size: 13px;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .novel-header {
    display: flex;
    gap: 30px;
    padding: 25px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .cover-container {
    flex: 0 0 190px;
  }

  .cover {
    width: 190px;
    height: 280px;
    object-fit: cover;
    border-radius: 5px;
  }

  .cover-placeholder {
    width: 190px;
    height: 280px;
    padding: 15px;
    background: linear-gradient(145deg, #3a291b, #171717);
    border: 1px solid #55402b;
    border-radius: 5px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
  }

  .cover-placeholder span {
    color: var(--accent);
    font-size: 12px;
    font-weight: bold;
  }

  .cover-placeholder strong {
    font-size: 18px;
  }

  .novel-details {
    flex: 1;
    min-width: 0;
  }

  .status {
    display: inline-block;
    padding: 5px 10px;
    background: #293c2d;
    color: #9cdda5;
    border-radius: 3px;
    font-size: 11px;
  }

  h1 {
    font-size: 28px;
    line-height: 1.3;
    margin: 12px 0 5px;
  }

  .raw-title {
    color: var(--muted);
    font-size: 14px;
  }

  .author {
    color: var(--muted);
    font-size: 13px;
    margin-top: 10px;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 12px;
  }

  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }

  .genre {
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--muted);
    font-size: 11px;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .read-button,
  .external-button {
    display: inline-block;
    padding: 10px 15px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
  }

  .read-button {
    background: var(--accent);
    color: #151515;
  }

  .read-button:hover {
    background: #ffb45e;
  }

  .external-button {
    border: 1px solid var(--border);
    color: var(--text);
  }

  .external-button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .synopsis-section {
    margin-top: 35px;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .synopsis-section h2 {
    font-size: 20px;
    margin-bottom: 12px;
  }

  .synopsis-section p {
    color: #ccc;
    font-size: 14px;
    line-height: 1.8;
    white-space: pre-line;
  }

  #chapter-list {
    scroll-margin-top: 20px;
  }

  @media (max-width: 600px) {
    .novel-header {
      flex-direction: column;
      align-items: center;
      padding: 18px;
      gap: 20px;
    }

    .cover-container,
    .cover,
    .cover-placeholder {
      width: 160px;
    }

    .cover-container {
      flex-basis: auto;
    }

    .cover,
    .cover-placeholder {
      height: 235px;
    }

    .novel-details {
      width: 100%;
    }

    h1 {
      font-size: 23px;
    }

    .metadata {
      gap: 12px;
    }
  }
                </style>