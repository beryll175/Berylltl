---
import { novels } from "../../../../content/novels.js";

export function getStaticPaths() {
  return novels.map((novel) => ({
    params: { slug: novel.slug },
    props: { novel }
  }));
}

const { novel } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit {novel.title} | Beryll TL Studio</title>
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/studio/studio.css">
</head>

<body>
  <div class="app">
    <aside class="sidebar">
      <div class="logo">BERYLL <span>TL</span></div>
      <div class="subtitle">Translation Studio</div>

      <div class="nav-label">Workspace</div>
      <a class="nav-item" href="/studio/index.html">Dashboard</a>
      <a class="nav-item active" href="/studio/novels/">Novels</a>

      <div class="nav-label">Other</div>
      <button class="nav-item">Settings</button>
    </aside>

    <main class="main">
      <header class="topbar">
        <div>
          <p style="color: var(--muted); font-size: 13px;">
            <a href={`/studio/novel/${novel.slug}/`} style="color: var(--muted);">
              {novel.title}
            </a>
            / Edit Information
          </p>
          <h1>Edit Novel</h1>
          <div class="status">Novel Information</div>
        </div>
      </header>

      <section class="form-container">
        <h2>Basic Information</h2>
        <p class="form-description">
          Update the details of this translated novel.
        </p>

        <form id="editNovelForm">
          <div class="form-section">
            <h3>Basic Information</h3>

            <div class="form-grid">
              <div class="form-field">
                <label>English Title *</label>
                <input name="title" type="text" value={novel.title} required>
              </div>

              <div class="form-field">
                <label>Chinese Title</label>
                <input name="rawTitle" type="text" value={novel.rawTitle}>
              </div>

              <div class="form-field">
                <label>Author</label>
                <input name="author" type="text" value={novel.author}>
              </div>

              <div class="form-field">
                <label>Novel Slug</label>
                <input name="slug" type="text" value={novel.slug} readonly>
              </div>

              <div class="form-field full">
                <label>Cover Image URL</label>
                <input name="cover" type="url" value={novel.cover}>
              </div>
            </div>
          </div>

          <div class="form-section">
            <h3>Description</h3>

            <div class="form-grid">
  <div class="form-field full">
    <label>Synopsis</label>

    <div
      id="synopsisEditor"
      class="studio-quill-editor"
      data-initial={novel.synopsis}
    ></div>

    <input
      type="hidden"
      name="synopsis"
      id="synopsisContent"
    >
  </div>
</div>

              <div class="form-field full">
                <label>Genres</label>
                <input
                  name="genres"
                  type="text"
                  value={novel.genres.join(", ")}
                  placeholder="Fantasy, Romance, Sci-fi"
                >
              </div>
            </div>
          </div>

          <div class="form-section">
            <h3>Publishing Details</h3>

            <div class="form-grid">
              <div class="form-field">
                <label>Translation Status</label>
                <select name="status">
                  <option selected={novel.status === "Ongoing"}>Ongoing</option>
                  <option selected={novel.status === "Completed"}>Completed</option>
                  <option selected={novel.status === "Hiatus"}>Hiatus</option>
                  <option selected={novel.status === "Coming Soon"}>Coming Soon</option>
                </select>
              </div>

              <div class="form-field">
                <label>Total Chapters</label>
                <input
                  name="totalChapters"
                  type="number"
                  min="0"
                  value={novel.totalChapters}
                >
              </div>

              <div class="form-field full">
                <label>Novel Updates Link</label>
                <input name="novelUpdates" type="url" value={novel.novelUpdates}>
              </div>

              <div class="form-field full">
                <label>Patreon Link</label>
                <input name="patreon" type="url" value={novel.patreon}>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <a
              href={`/studio/novel/${novel.slug}/`}
              class="secondary-btn"
              style="text-decoration: none; text-align: center;"
            >
              Cancel
            </a>

            <button type="submit" class="primary-btn">
              Save Changes
            </button>
          </div>
        </form>
      </section>
    </main>
  </div>
  <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

<script is:inline>
  const synopsisEditor = new Quill("#synopsisEditor", {
    theme: "snow",
    placeholder: "Write a synopsis...",
    modules: {
      toolbar: [
        [{ header: [1, 2, 3, false] }],
        ["bold", "italic", "underline", "strike"],
        [{ list: "ordered" }, { list: "bullet" }],
        [{ align: [] }],
        ["blockquote"],
        ["link"],
        ["clean"]
      ]
    }
  });

  const synopsisElement = document.getElementById("synopsisEditor");
  const synopsisContent = document.getElementById("synopsisContent");
  const editForm = document.getElementById("editNovelForm");

  synopsisEditor.setText(synopsisElement.dataset.initial || "");

  editForm.addEventListener("submit", function () {
    synopsisContent.value = synopsisEditor.root.innerHTML;
  });
</script>
</body>
  </html>