---
import { novels } from "../../../../../../../content/novels.js";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("chapters");

  return novels.flatMap((novel) => {
    const chapters = entries.filter(
      (entry) => entry.data.novel === novel.slug
    );

    return chapters.map((chapter) => ({
      params: {
        slug: novel.slug,
        chapterNumber: String(chapter.data.number)
      },
      props: {
        novel,
        chapter
      }
    }));
  });
}

const { novel, chapter } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Chapter {chapter.data.number} | {novel.title}</title>

  <link
    href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/studio/studio.css">
</head>

<body>

  <div class="app">

    <aside class="sidebar">
      <div class="logo">BERYLL <span>TL</span></div>
      <div class="subtitle">Translation Studio</div>

      <div class="nav-label">Workspace</div>
      <a class="nav-item" href="/studio/index.html">Dashboard</a>
      <a class="nav-item active" href="/studio/novels/">Novels</a>

      <div class="nav-label">Other</div>
      <button class="nav-item">Settings</button>
    </aside>

    <main class="main">

      <header class="topbar">
        <div>
          <p style="color: var(--muted); font-size: 13px;">
            <a href="/studio/novels/" style="color: var(--muted);">
              Novels
            </a>
            /
            <a
              href={`/studio/novel/${novel.slug}/`}
              style="color: var(--muted);"
            >
              {novel.title}
            </a>
            /
            <a
              href={`/studio/novel/${novel.slug}/chapters/`}
              style="color: var(--muted);"
            >
              Chapters
            </a>
            / Edit Chapter
          </p>

          <h1>Edit Chapter</h1>
          <div class="status">{novel.title}</div>
        </div>
      </header>

      <section class="form-container">

        <h2>Chapter {chapter.data.number}</h2>

        <p class="form-description">
          Edit this chapter of {novel.title}.
        </p>

        <form id="editChapterForm">
          <input
  type="hidden"
  name="chapterId"
  value={chapter.id}
/>

          <div class="form-section">
            <h3>Chapter Information</h3>

            <div class="form-grid">

              <div class="form-field">
                <label>Chapter Number *</label>
                <input
                  type="number"
                  name="number"
                  min="1"
                  value={chapter.data.number}
                  required
                >
              </div>

              <div class="form-field">
                <label>Chapter Title *</label>
                <input
                  type="text"
                  name="title"
                  value={chapter.data.title}
                  required
                >
              </div>

              <div class="form-field">
                <label>Volume</label>
                <input
                  type="text"
                  name="volume"
                  value={chapter.data.volume || ""}
                >
              </div>

              <div class="form-field">
                <label>Last Updated</label>
                <input
                  type="date"
                  name="updated"
                  value={chapter.data.updated || ""}
                >
              </div>

            </div>
          </div>

          <div class="form-section">
            <h3>Chapter Content</h3>

            <div class="form-field full">

              <label>Chapter Text *</label>

              <div
                id="editor"
                class="studio-quill-editor"
                data-initial={chapter.body || ""}
              ></div>

              <input
                type="hidden"
                name="content"
                id="chapterContent"
              >

              <div style="display: flex; justify-content: space-between; margin-top: 10px; color: var(--muted); font-size: 13px;">
                <span id="wordCount">0 words</span>
                <span id="characterCount">0 characters</span>
              </div>

            </div>
          </div>

          <div class="form-actions">

            <a
              href={`/studio/novel/${novel.slug}/chapters/`}
              class="secondary-btn"
              style="text-decoration: none; text-align: center;"
            >
              Cancel
            </a>

            <button type="button" class="primary-btn">
              Save Changes
            </button>

          </div>

        </form>

      </section>

    </main>

  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

  <script is:inline>
    const editorElement = document.getElementById("editor");

    const quill = new Quill("#editor", {
      theme: "snow",
      placeholder: "Edit your translated chapter here...",
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ["bold", "italic", "underline", "strike"],
          [{ list: "ordered" }, { list: "bullet" }],
          [{ align: [] }],
          ["blockquote"],
          ["link"],
          ["clean"]
        ]
      }
    });

    quill.setText(editorElement.dataset.initial || "");

    const wordCount = document.getElementById("wordCount");
    const characterCount = document.getElementById("characterCount");
    const chapterContent = document.getElementById("chapterContent");

    function updateCounts() {
      const text = quill.getText().trim();

      const words = text ? text.split(/\s+/).length : 0;
      const characters = text.length;

      wordCount.textContent = words + " words";
      characterCount.textContent = characters + " characters";

      chapterContent.value = quill.root.innerHTML;
    }

    quill.on("text-change", updateCounts);
    updateCounts(); 
    
    const editChapterForm = document.getElementById("editChapterForm");

editChapterForm.addEventListener("submit", async function (event) {
  event.preventDefault();

  chapterContent.value = quill.root.innerHTML;

  const password = prompt("Enter your Studio admin password:");

  if (!password) return;

  const formData = new FormData(editChapterForm);
  const data = Object.fromEntries(formData.entries());

  try {
    const saveButton = editChapterForm.querySelector('button[type="submit"]');

    saveButton.disabled = true;
    saveButton.textContent = "Saving...";

    const result = await fetch("/api/chapters", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${password}`
      },
      body: JSON.stringify(data)
    });

    const responseData = await result.json();

    if (!result.ok) {
      throw new Error(responseData.error || "Could not save chapter.");
    }

    alert("Chapter updated successfully!");

    window.location.href = `/studio/novel/${data.chapterId.split("/")[0]}/chapters/`;

  } catch (error) {
    alert(error.message);

    const saveButton = editChapterForm.querySelector('button[type="submit"]');

    saveButton.disabled = false;
    saveButton.textContent = "Save Changes";
  }
});

  </script>

</body>
  </html>