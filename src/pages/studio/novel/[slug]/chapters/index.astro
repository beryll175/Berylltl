---
import { novels } from "../../../../../content/novels.js";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("chapters");

  return novels.map((novel) => {
    const chapters = entries
      .filter((entry) => entry.data.novel === novel.slug)
      .sort((a, b) => a.data.number - b.data.number);

    return {
      params: { slug: novel.slug },
      props: { novel, chapters }
    };
  });
}

const { novel, chapters } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chapters | {novel.title} | Beryll TL Studio</title>
  <link rel="stylesheet" href="/studio/studio.css">
</head>

<body>
  <div class="app">

    <aside class="sidebar">
      <div class="logo">BERYLL <span>TL</span></div>
      <div class="subtitle">Translation Studio</div>

      <div class="nav-label">Workspace</div>
      <a class="nav-item" href="/studio/index.html">Dashboard</a>
      <a class="nav-item active" href="/studio/novels/">Novels</a>

      <div class="nav-label">Other</div>
      <button class="nav-item">Settings</button>
    </aside>

    <main class="main">

      <header class="topbar">
        <div>
          <p style="color: var(--muted); font-size: 13px;">
            <a href="/studio/novels/" style="color: var(--muted);">
              Novels
            </a>
            /
            <a href={`/studio/novel/${novel.slug}/`} style="color: var(--muted);">
              {novel.title}
            </a>
            / Chapters
          </p>

          <h1>Chapter Management</h1>

          <div class="status">
            {novel.title}
          </div>
        </div>

        <a
          href={`/studio/novel/${novel.slug}/chapters/new/`}
          class="primary-btn"
          style="text-decoration: none;"
        >
          + Add Chapter
        </a>
      </header>

      <section class="form-container">

        <h2>Chapter Library</h2>

        <p class="form-description">
          Manage chapters belonging to {novel.title}.
        </p>

        <div class="form-grid">
          <div class="form-field">
            <label>Total Chapters</label>
            <h2>{chapters.length}</h2>
          </div>

          <div class="form-field">
            <label>Novel Status</label>
            <h2>{novel.status}</h2>
          </div>
        </div>

        <div class="form-section">

          <h3>All Chapters</h3>

          {chapters.length > 0 ? (
            <div style="overflow-x: auto;">
              <table style="width: 100%; border-collapse: collapse; text-align: left;">

                <thead>
                  <tr>
                    <th style="padding: 14px;">Chapter</th>
                    <th style="padding: 14px;">Title</th>
                    <th style="padding: 14px;">Volume</th>
                    <th style="padding: 14px;">Last Updated</th>
                    <th style="padding: 14px;">Action</th>
                  </tr>
                </thead>

                <tbody>
                  {chapters.map((chapter) => (
                    <tr>
                      <td style="padding: 14px;">
                        {chapter.data.number}
                      </td>

                      <td style="padding: 14px;">
                        {chapter.data.title}
                      </td>

                      <td style="padding: 14px;">
                        {chapter.data.volume || "—"}
                      </td>

                      <td style="padding: 14px;">
                        {chapter.data.updated || "—"}
                      </td>

                      <td style="padding: 14px;">
  <a
    href={`/studio/novel/${novel.slug}/chapters/${chapter.data.number}/edit/`}
    class="secondary-btn"
    style="text-decoration: none;"
  >
    Edit
  </a>
</td>
                    </tr>
                  ))}
                </tbody>

              </table>
            </div>
          ) : (
            <p class="form-description">
              No chapters have been added to this novel yet.
            </p>
          )}

        </div>

        <div class="form-actions">
          <a
            href={`/studio/novel/${novel.slug}/`}
            class="secondary-btn"
            style="text-decoration: none;"
          >
            Back to Novel
          </a>
        </div>

      </section>

    </main>
  </div>
</body>
</html>