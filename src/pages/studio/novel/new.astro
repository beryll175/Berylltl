<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Add Novel | Beryll TL Studio</title>
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <link rel="stylesheet" href="/studio/studio.css">
</head>

<body>

  <div class="app">

    <aside class="sidebar">

      <div class="logo">BERYLL <span>TL</span></div>
      <div class="subtitle">Translation Studio</div>

      <div class="nav-label">Workspace</div>

      <a class="nav-item" href="/studio/index.html">Dashboard</a>
      <a class="nav-item active" href="/studio/novels/">Novels</a>

      <div class="nav-label">Other</div>

      <button class="nav-item">Settings</button>

    </aside>

    <main class="main">

      <header class="topbar">

        <div>
          <p style="color: var(--muted); font-size: 13px; margin-bottom: 6px;">
            Studio / Novels / Add Novel
          </p>

          <h1>Add Novel</h1>
        </div>

        <div class="status">Creating New Novel</div>

      </header>

      <section class="form-container">

        <h2>New Novel</h2>

        <p class="form-description">
          Add a translated novel to your Beryll TL library.
        </p>

        <form id="novelForm">

          <div class="form-section">

            <h3>Basic Information</h3>

            <div class="form-grid">

              <div class="form-field">
                <label>English Title *</label>
                <input
                  type="text"
                  id="novelTitle"
                  name="title"
                  placeholder="Enter English title"
                  required
                >
              </div>

              <div class="form-field">
                <label>Chinese Title</label>
                <input
                  type="text"
                  name="rawTitle"
                  placeholder="Enter original title"
                >
              </div>

              <div class="form-field">
                <label>Author</label>
                <input
                  type="text"
                  name="author"
                  placeholder="Author's name"
                >
              </div>

              <div class="form-field">
                <label>Novel Slug *</label>
                <input
                  type="text"
                  id="novelSlug"
                  name="slug"
                  placeholder="Automatically generated"
                  required
                  readonly
                >
              </div>

              <div class="form-field full">
                <label>Cover Image URL</label>
                <input
                  type="url"
                  name="cover"
                  placeholder="https://example.com/cover.jpg"
                >
              </div>

            </div>

          </div>

          <div class="form-section">

            <h3>Description</h3>

            <div class="form-grid">

              <div class="form-field full">
  <label>Synopsis</label>

  <div
    id="synopsisEditor"
    class="studio-quill-editor"
  ></div>

  <input
    type="hidden"
    name="synopsis"
    id="synopsisContent"
  >
              </div>

              <div class="form-field full">
                <label>Genres</label>
                <input
                  type="text"
                  name="genres"
                  placeholder="Fantasy, Romance, Sci-fi"
                >
              </div>

            </div>

          </div>

          <div class="form-section">

            <h3>Publishing Details</h3>

            <div class="form-grid">

              <div class="form-field">
                <label>Translation Status</label>

                <select name="status">
                  <option>Ongoing</option>
                  <option>Completed</option>
                  <option>Hiatus</option>
                  <option>Coming Soon</option>
                </select>
              </div>

              <div class="form-field">
                <label>Total Chapters</label>

                <input
                  type="number"
                  name="totalChapters"
                  min="0"
                  value="0"
                >
              </div>

              <div class="form-field full">
                <label>Novel Updates Link</label>
                <input type="url" name="novelUpdates">
              </div>

              <div class="form-field full">
                <label>Patreon Link</label>
                <input type="url" name="patreon">
              </div>

            </div>

          </div>

          <div class="form-actions">

            <a
  href="/studio/novels/"
  class="secondary-btn"
  style="text-decoration: none; text-align: center;"
>
  Cancel
            </a>
            <button type="submit" class="primary-btn">
              Save Novel
            </button>

          </div>

        </form>

      </section>

    </main>

  </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

<script is:inline>
  const synopsisEditor = new Quill("#synopsisEditor", {
    theme: "snow",
    placeholder: "Write the novel synopsis...",
    modules: {
      toolbar: [
        [{ header: [1, 2, 3, false] }],
        ["bold", "italic", "underline", "strike"],
        [{ list: "ordered" }, { list: "bullet" }],
        [{ align: [] }],
        ["blockquote"],
        ["link"],
        ["clean"]
      ]
    }
  });

  const synopsisContent = document.getElementById("synopsisContent");
  const novelForm = document.getElementById("novelForm");

  novelForm.addEventListener("submit", function () {
    synopsisContent.value = synopsisEditor.root.innerHTML;
  });
</script>
    <script>
  const titleInput = document.getElementById("novelTitle");
  const slugInput = document.getElementById("novelSlug");
  const novelForm = document.getElementById("novelForm");

  // Generate novel slug automatically
  titleInput.addEventListener("input", () => {
    slugInput.value = titleInput.value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");
  });

  // Save novel
  novelForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    const password = prompt("Enter your studio admin password:");

    if (!password) {
      return;
    }

    const saveButton = novelForm.querySelector(
      'button[type="submit"]'
    );

    saveButton.disabled = true;
    saveButton.textContent = "Saving...";

    const formData = new FormData(novelForm);
    const novelData = Object.fromEntries(formData.entries());

    try {
      const response = await fetch("/api/novels", {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${password}`
        },

        body: JSON.stringify(novelData)
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || "Could not save novel.");
      }

      alert("Novel saved successfully!");

      window.location.href = "/studio/novels/";

    } catch (error) {
      alert(error.message);
    }

    saveButton.disabled = false;
    saveButton.textContent = "Save Novel";
  });
</script>

</body>
</html>