---

import MainLayout from "../layouts/MainLayout.astro";
import NovelCard from "../components/NovelCard.astro";
import { novels } from "../content/novels.js";
import { getCollection } from "astro:content";

const chapterEntries = await getCollection("chapters");

const availableNovels = novels
  .filter((novel) => novel.status !== "Coming Soon")
  .map((novel) => ({
    ...novel,
    totalChapters: chapterEntries.filter(
      (chapter) => chapter.data.novel === novel.slug
    ).length
  }));
---
<MainLayout
  title="Beryll TL | Chinese Novel Translations"
  description="Read Chinese novels translated into English by Beryll TL."
>

  <section class="hero">
    <span class="hero-label">CHINESE NOVEL TRANSLATIONS</span><h1>Stories worth<br /><span>staying up for!</span></h1>

<p>
  Discover translated Chinese novels, one chapter at a time.
  Your next favourite story starts here.
</p>

<a href="#novels" class="hero-button">Explore Novels ↓</a>

  </section>  <section class="novels-section" id="novels">
    <div class="section-heading">
      <div>
        <span class="section-label">OUR LIBRARY</span>
        <h2>Currently Translating</h2>
      </div>  <span class="novel-count">{availableNovels.length} Novels</span>
</div>

{availableNovels.length > 0 ? (
  <div class="novel-list">
    {availableNovels.map((novel) => (
      <NovelCard
        {...novel}
        href={`/novels/${novel.slug}/`}
      />
    ))}
  </div>
) : (
  <div class="empty-library">
    <h3>Something is brewing...</h3>
    <p>
      We're preparing our first translations.
      Check back soon for new stories!
    </p>
  </div>
)}

  </section>  <section class="about-section">
    <h2>About Beryll TL</h2>
    <p>
      Beryll TL brings Chinese web novels to English-speaking readers.
      Explore new stories and enjoy free translations, one chapter at a time.
    </p>
  </section>
</MainLayout><style>
  .hero {
    padding: 85px 25px;
    text-align: center;
    background: linear-gradient(145deg, #292016, #191919 65%);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 55px;
  }

  .hero-label,
  .section-label {
    color: var(--accent);
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .hero h1 {
    font-size: clamp(38px, 7vw, 65px);
    line-height: 1.15;
    margin: 20px 0;
  }

  .hero h1 span {
    color: var(--accent);
  }

  .hero p {
    max-width: 480px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
  }

  .hero-button {
    display: inline-block;
    margin-top: 28px;
    padding: 12px 22px;
    background: var(--accent);
    color: #151515;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
  }

  .hero-button:hover {
    background: #ffb45e;
  }

  .novels-section {
    margin-bottom: 55px;
    scroll-margin-top: 25px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    font-size: 25px;
    margin-top: 7px;
  }

  .novel-count {
    color: var(--muted);
    font-size: 12px;
  }

  .novel-list {
    display: grid;
    gap: 18px;
  }

  .empty-library {
    padding: 45px 20px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .empty-library h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }

  .empty-library p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .about-section {
    padding: 30px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 35px;
  }

  .about-section h2 {
    font-size: 21px;
    margin-bottom: 12px;
  }

  .about-section p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 65px 18px;
    }

    .section-heading h2 {
      font-size: 20px;
    }

    .about-section {
      padding: 22px;
    }
  }
  </style>